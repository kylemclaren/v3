---
import { Mascot } from 'page-mascot'

// Both sheets are built by the page-mascot pipeline from characters/birdman/.
const directions = '/mascots/birdman-directions.webp'
const reactions = '/mascots/birdman-reactions.webp'
---

<div class="peeking-bird" transition:persist="peeking-bird">
  <div class="peeking-bird__bob">
    <Mascot client:idle {directions} {reactions} size={140} label="bird" />
  </div>
</div>

<style>
  .peeking-bird {
    position: fixed;
    bottom: 0;
    right: clamp(1rem, 8vw, 5rem);
    z-index: 30;
    line-height: 0;
    /* Tuck the lower body below the edge so the head and top of the chest show. */
    transform: translateY(22%);
    filter: drop-shadow(0 -3px 8px hsl(var(--foreground) / 0.12));
  }

  .peeking-bird__bob {
    /* Gentle idle bob, composed on top of the wrapper's peek transform. */
    animation: bird-bob 5s ease-in-out infinite;
  }

  @keyframes bird-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  /* Keep mobile footer uncluttered. Cursor tracking is off there anyway. */
  @media (max-width: 639px) {
    .peeking-bird {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .peeking-bird__bob {
      animation: none;
    }
  }
</style>
