---
import { Image } from 'astro:assets'
import avatar from '~/assets/avatar.webp'
---

<a href="/" class="avatar-link pointer-events-auto select-none flex-shrink-0" aria-label="Home" transition:persist>
  <Image
    src={avatar}
    width={64}
    height={64}
    alt="Kyle McLaren"
    class="avatar-thumb w-8 h-8 rounded-full object-cover"
    densities={[1, 2]}
    loading="eager"
  />
  <span class="avatar-popout" aria-hidden="true">
    <Image src={avatar} width={320} height={320} alt="" class="avatar-popout__img" densities={[1, 2]} loading="eager" />
  </span>
</a>

<style>
  .avatar-link {
    position: relative;
    display: inline-flex;
  }

  .avatar-thumb {
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }

  .avatar-link:hover .avatar-thumb {
    transform: scale(1.05);
    box-shadow: 0 0 0 2px hsl(var(--background)), 0 0 0 4px hsl(var(--primary) / 0.4);
  }

  .avatar-popout {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 50;
    display: block;
    box-sizing: border-box;
    width: 130px;
    height: 130px;
    padding: 5px;
    border-radius: 9999px;
    background: hsl(var(--background));
    box-shadow:
      0 0 0 1px hsl(var(--border)),
      0 18px 40px -12px hsl(var(--foreground) / 0.35);
    opacity: 0;
    transform: scale(0.4) translateY(-10px);
    transform-origin: top left;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .avatar-link:hover .avatar-popout,
  .avatar-link:focus-visible .avatar-popout {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .avatar-popout__img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-thumb,
    .avatar-popout {
      transition: opacity 0.15s ease;
    }
    .avatar-link:hover .avatar-thumb {
      transform: none;
    }
    .avatar-link:hover .avatar-popout,
    .avatar-link:focus-visible .avatar-popout {
      transform: none;
    }
  }
</style>
